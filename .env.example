NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_API_BASE_URL=https://app-apimahalaxmi-api.vercel.app

# Price list (set these on the Nest API, apps/api). The Tally price list export lives in
# Google Drive and is imported on demand from Admin > Price List > Update from Tally.
# Preferred: a private file read through a service account. Share the file with the
# service account's client_email (Viewer) and paste the key JSON as a single line.
PRICE_LIST_DRIVE_FILE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative: a public direct-download link, used only when the two values above are empty.
# Example: https://drive.google.com/uc?export=download&id=YOUR_FILE_ID
GOOGLE_DRIVE_PRODUCTS_URL=

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Client Configuration for Mobile SMS Login
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id


R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-product-images-bucket
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Optional legacy fallback if you still need Amazon S3 compatibility during migration.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
