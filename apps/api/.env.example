PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
REDIS_URL=redis://localhost:6379

# Queue settings (set to true to bypass Redis locally and run workers synchronously)
DISABLE_QUEUES=true

# Storage Settings (Cloudflare R2 or AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=photo-product-bucket
AWS_S3_PUBLIC_BASE_URL=https://eu-north-1.console.aws.amazon.com/s3/buckets/photo-product-bucket?region=eu-north-1&tab=objects

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=product-image-store
R2_PUBLIC_BASE_URL=https://your-r2-account-id.r2.cloudflarestorage.com

# Use a separate private R2 bucket for worker/site photos. Do not configure this bucket as public.
R2_PROJECT_MEDIA_BUCKET=project-media-private

# Price list: Tally export in Google Drive, imported from Admin > Price List > Update from Tally.
# Share the file with the service account's client_email and paste the key JSON as a single line.
PRICE_LIST_DRIVE_FILE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative when the two values above are empty: a public direct-download link.
GOOGLE_DRIVE_PRODUCTS_URL=

# Phone OTP via TextBee (textbee.dev): codes are sent from your Android phone registered
# there. TextBee dashboard -> API keys, and the device ID of the phone.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional: most codes sent per day across all numbers (protects the SIM). Default 200.
TEXTBEE_DAILY_LIMIT=200
# Random secret mixed into stored OTP hashes, e.g. from: openssl rand -hex 32
OTP_SECRET=
