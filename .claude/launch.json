{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "mobile",
      "port": 8081,
      "env": {
        "CI": "1",
        "BROWSER": "none"
      }
    }
  ]
}